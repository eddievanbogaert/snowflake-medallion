# ============================================================
# Snowflake Connection Settings
# Copy this file to .env and populate with real values.
# NEVER commit the .env file to version control.
# ============================================================

# Snowflake Account (format: <orgname>-<accountname> or <account>.<region>.<cloud>)
SNOWFLAKE_ACCOUNT=myorg-myaccount

# Snowflake connection details for dbt service account
SNOWFLAKE_USER=svc_dbt_transformer
SNOWFLAKE_PRIVATE_KEY_PATH=/path/to/rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# Alternatively, use password auth (not recommended for production)
# SNOWFLAKE_PASSWORD=

SNOWFLAKE_ROLE=TRANSFORMER_ROLE
SNOWFLAKE_WAREHOUSE=TRANSFORM_WH
SNOWFLAKE_DATABASE=FOUNDATION_DB
SNOWFLAKE_SCHEMA=DBT_STAGING

# ============================================================
# AWS S3 Integration
# ============================================================
AWS_ACCOUNT_ID=123456789012
S3_BUCKET_RAW=my-company-snowflake-raw
S3_BUCKET_REGION=us-east-1

# The IAM role ARN Snowflake will assume (created by bootstrap)
SNOWFLAKE_S3_IAM_ROLE_ARN=arn:aws:iam::123456789012:role/snowflake-s3-access-role

# ============================================================
# SQL Server Source
# ============================================================
SQLSERVER_HOST=sqlserver.internal.mycompany.com
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=OperationalDB
SQLSERVER_USER=svc_snowflake_reader
# Password managed via secrets manager - do not store here
# SQLSERVER_PASSWORD=

# ============================================================
# Azure AD / SAML (for PowerBI SSO)
# ============================================================
AZURE_AD_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_AD_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Client secret managed via secrets manager - do not store here
# AZURE_AD_CLIENT_SECRET=

# ============================================================
# Monitoring / Alerting
# ============================================================
ALERT_EMAIL=data-platform-alerts@mycompany.com
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
